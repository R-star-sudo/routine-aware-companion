# Copy these values into your local backend/.env file.
# Never commit your real API key.
ELEVENLABS_API_KEY=replace_with_your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=replace_with_your_voice_id
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Optional: override the default MP3 voice model in backend/app/services/voice_service.py.
